{
  "permissions": {
    "allow": [
      "Edit(margi/**)",
      "Bash(uv run margi finalize:*)",
      "Bash(uv run margi outline:*)",
      "Bash(uv run margi status:*)",
      "Bash(uv run margi extract-pdfs:*)"
    ],
    "deny": [
      "Edit(**/*.typ)",
      "Edit(**/*.bib)",
      "Edit(**/*.tex)",
      "Edit(**/*.qmd)",
      "Edit(thesis.config.yml)",
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(AGENTS.md)",
      "Edit(.agents/**)",
      "Edit(.githooks/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ]
  }
}
